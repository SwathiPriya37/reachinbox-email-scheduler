# ─────────────────────────────────────────────
# Backend — copy to backend/.env
# ─────────────────────────────────────────────

# PostgreSQL connection string (matches docker-compose defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox"

# Redis connection string (matches docker-compose defaults)
REDIS_URL="redis://localhost:6379"

# Express server port
PORT=3001

# ── BullMQ Worker ──────────────────────────────
# Number of concurrent email jobs the worker processes simultaneously
WORKER_CONCURRENCY=5

# BullMQ limiter: max jobs per duration window (burst throttle, not hourly cap)
# Default: 10 jobs per 1000ms → 1 send per 100ms minimum
RATE_LIMITER_MAX=10
MIN_DELAY_BETWEEN_SENDS_MS=1000

# ── Hourly send limits ─────────────────────────
# Per-sender hourly email cap (overridden per sender in DB if set)
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Global hourly cap across all senders
MAX_EMAILS_PER_HOUR_GLOBAL=500

# ─────────────────────────────────────────────
# Frontend — copy to frontend/.env.local
# ─────────────────────────────────────────────

# Google OAuth credentials (from Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_32_chars_minimum"

# NextAuth canonical URL (must match deployment URL)
NEXTAUTH_URL="http://localhost:3000"

# Backend API base URL (used by frontend server-side and client-side fetch)
NEXT_PUBLIC_API_URL="http://localhost:3001"
