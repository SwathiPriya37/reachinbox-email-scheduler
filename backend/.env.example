# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# Express server port
PORT=3001

# Worker concurrency (number of concurrent email jobs processed)
WORKER_CONCURRENCY=5

# BullMQ burst rate limiter settings
RATE_LIMITER_MAX=10
MIN_DELAY_BETWEEN_SENDS_MS=1000

# Per-sender hourly rate cap
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MAX_EMAILS_PER_HOUR_GLOBAL=500

# Environment mode
NODE_ENV=development
