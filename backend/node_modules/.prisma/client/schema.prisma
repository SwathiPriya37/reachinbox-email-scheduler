// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Sender {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  smtpHost    String
  smtpPort    Int
  smtpUser    String
  smtpPass    String
  smtpSecure  Boolean  @default(false)
  hourlyLimit Int? // per-sender override; null falls back to global env var
  emails      Email[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("senders")
}

model Email {
  id            String      @id @default(cuid())
  senderId      String
  sender        Sender      @relation(fields: [senderId], references: [id])
  recipient     String
  subject       String
  body          String      @db.Text
  scheduledTime DateTime
  status        EmailStatus @default(PENDING)
  sentTime      DateTime?
  bullmqJobId   String? // stored for audit/debugging; actual dedup is via BullMQ jobId
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Dashboard queries filter on status and scheduledTime
  @@index([status])
  @@index([scheduledTime])
  @@index([senderId, status])
  @@map("emails")
}
